# Supabase public settings — the anon key is used only by read-only public
# experiences such as the /order preview, with RLS enforcing visibility.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only waitlist writer. Never prefix this key with NEXT_PUBLIC_ and
# never expose it in browser code. Required by POST /api/waitlist.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated Supabase Auth email addresses permitted to use /admin.
# Authorization is re-checked server-side on every admin API request.
ADMIN_EMAILS=

# App Store listing — placeholder until the October 2026 launch. When unset,
# "Get the app" buttons fall back to the waitlist form instead of a dead link.
APP_STORE_URL=
